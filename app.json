{
  "expo": {
    "name": "Tea Thermal Monitor",
    "slug": "tea-thermal-monitor",
    "version": "1.0.0",
    "scheme": "teathermal",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C120F",
    "android": {
      "package": "lk.pdn.etic.teathermal",
      "adaptiveIcon": { "backgroundColor": "#0C120F" },
      "permissions": ["VIBRATE", "POST_NOTIFICATIONS"]
    },
    "ios": {
      "bundleIdentifier": "lk.pdn.etic.teathermal",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "color": "#F5A63C" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
