{
  "expo": {
    "name": "Tea Thermal Monitor",
    "slug": "tea-thermal-monitor",
    "version": "1.0.0",
    "scheme": "teathermal",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C120F",
    "android": {
      "package": "lk.pdn.etic.teathermal",
      "adaptiveIcon": {
        "backgroundColor": "#0C120F"
      },
      "permissions": [
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "lk.pdn.etic.teathermal",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#F5A63C"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4516a24e-96e9-4cfc-9216-9b1a8eb75a3e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4516a24e-96e9-4cfc-9216-9b1a8eb75a3e"
    }
  }
}
